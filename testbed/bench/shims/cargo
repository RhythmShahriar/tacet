#
# cargo in Docker for machines without it. compare.sh puts shims/ on
# PATH only when the real command is missing, for every mode alike.
set -euo pipefail
image=rust:1.83-slim
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
rel=${PWD#"$root"}
exec docker run --rm -i -u "$(id -u):$(id -g)" -e HOME=/tmp -e CARGO_HOME=/tmp/cargo \
	-v "$root:/w" -w "/w$rel" "$image" cargo "$@"
