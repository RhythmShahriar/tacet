#
# pytest in Docker for machines without it. compare.sh puts shims/ on
# PATH only when the real command is missing, for every mode alike.
set -euo pipefail
image=tacet-bench-pytest:8.3.3
if ! docker image inspect "$image" >/dev/null 2>&1; then
	printf 'FROM python:3.12-slim\nRUN pip install --no-cache-dir pytest==8.3.3\n' |
		docker build -q -t "$image" - >/dev/null
fi
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
rel=${PWD#"$root"}
exec docker run --rm -i -u "$(id -u):$(id -g)" -e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 \
	-v "$root:/w" -w "/w$rel" "$image" pytest -p no:cacheprovider "$@"
